{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch VBA (live sync)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\watch_vba.ps1",
        "-WorkbookPath",
        "${input:liveWorkbookPath}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Watch VBA (live sync + save workbook)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\watch_vba.ps1",
        "-WorkbookPath",
        "${input:liveWorkbookPath}",
        "-SaveAfterSync"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build add-in",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\build_xlam.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Start test Excel instance",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\start_test_excel.ps1",
        "-AddInPath",
        "${input:liveWorkbookPath}",
        "-Caption",
        "${input:testInstanceCaption}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start test Excel instance + watch VBA",
      "dependsOn": [
        "Start test Excel instance",
        "Watch VBA (live sync + save workbook)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Run macro in Excel",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\run_vba_macro.ps1",
        "-WorkbookPath",
        "${input:liveWorkbookPath}",
        "-MacroName",
        "${input:macroName}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Smoke test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\smoke_test.ps1",
        "-SkipBuild",
        "-ForceCloseExcel"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Publish installed add-in",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\publish_addin.ps1",
        "-ForceCloseExcel"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "liveWorkbookPath",
      "type": "promptString",
      "description": "Full path of the open dev workbook or add-in to live-sync into",
      "default": "${workspaceFolder}\\dist\\FAS_Toolkit.xlam"
    },
    {
      "id": "macroName",
      "type": "promptString",
      "description": "Public Sub macro name to run in the open workbook or add-in",
      "default": "FAS_ShowNavigator"
    },
    {
      "id": "testInstanceCaption",
      "type": "promptString",
      "description": "Caption shown on the dedicated test Excel instance",
      "default": "TEST INSTANCE"
    }
  ]
}
