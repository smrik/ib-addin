{
  "files.associations": {
    "*.bas": "vb",
    "*.cls": "vb",
    "*.frm": "vb"
  },
  "files.eol": "\r\n",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "[vb]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "AmaneMikoto.xlcraft"
  },
  "search.exclude": {
    "**/.git": true,
    "**/.scratch": true,
    "**/backups": true,
    "**/logs": true,
    "**/Lunacy/runs": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/*.xlam": true,
    "**/*.ppam": true,
    "**/*.xlsx": true,
    "**/*.xlsb": true,
    "**/*.exe": true
  },
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.scratch/**": true,
    "**/backups/**": true,
    "**/Lunacy/runs/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true
  }
}
